{
  "manifest_version": 3,
  "name": "iVysílání Enhancer",
  "version": "0.1.0",
  "description": "Improves the iVysílání video player on ceskatelevize.cz: adds a floating Play/Pause button.",
  "content_scripts": [
    {
      "matches": [
        "https://www.ceskatelevize.cz/*",
        "https://ct24.ceskatelevize.cz/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://www.ceskatelevize.cz/*",
    "https://ct24.ceskatelevize.cz/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "ivysilani-web-extension@example.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
