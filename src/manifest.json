{
  "manifest_version": 3,
  "name": "Hello World Extension",
  "version": "0.0.1",
  "description": "Shows a small \"Hello World\" badge in the bottom-left corner of every page.",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["<all_urls>"],
  "browser_specific_settings": {
    "gecko": {
      "id": "hello-world@example.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
