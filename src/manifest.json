{
  "manifest_version": 3,
  "name": "Enhancer for iVysílání",
  "version": "1.0.0",
  "description": "Unofficial add-on for Česká televize's iVysílání player: speed control, seeking on live streams, lasting pauses, a bigger buffer.",
  "homepage_url": "https://github.com/zdenda/ivysilani-web-extension",
  "minimum_chrome_version": "120",
  "content_scripts": [
    {
      "matches": [
        "https://www.ceskatelevize.cz/*",
        "https://ct24.ceskatelevize.cz/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.ceskatelevize.cz/*",
        "https://ct24.ceskatelevize.cz/*"
      ],
      "js": ["page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "host_permissions": [
    "https://www.ceskatelevize.cz/*",
    "https://ct24.ceskatelevize.cz/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "enhancer-for-ivysilani@zdenda.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
